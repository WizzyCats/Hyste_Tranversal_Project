{{ form_start(form) }}
    {{ form_row(form.titre) }}
    {{ form_row(form.description) }}
    {{ form_row(form.instructions) }}
    {{ form_row(form.tempsPreparation) }}
    {{ form_row(form.difficulte) }}
    {{ form_row(form.image) }}
    {{ form_row(form.categorie) }}

<div data-controller="collection"
     data-collection-prototype-value="{{ form_widget(form.recetteIngredients.vars.prototype)|e('html_attr') }}"
     data-collection-index-value="{{ form.recetteIngredients|length }}">
    <h3>Ingrédients</h3>
    <ul data-collection-target="list">
        {% for ligne in form.recetteIngredients %}
            <li>{{ form_widget(ligne) }}</li>
        {% endfor %}
    </ul>
    <button type="button" data-action="collection#add">+ Ajouter un ingrédient</button>
</div>
{% do form.recetteIngredients.setRendered %}

    {{ form_rest(form) }}
<button class="btn">{{ button_label|default('Save') }}</button>
{{ form_end(form) }}
