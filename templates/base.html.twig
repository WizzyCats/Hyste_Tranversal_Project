<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>{% block title %}Chef's Table{% endblock %}</title>
    {# garde ici ta ligne <link rel="icon" ...> d'origine #}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&display=swap" rel="stylesheet">
    {% block stylesheets %}{% endblock %}
    {% block javascripts %}
        {% block importmap %}{{ importmap('app') }}{% endblock %}
    {% endblock %}
</head>
<body>
<div id="app">
    {% set route = app.request.attributes.get('_route') %}
    <header>
        <nav>
            <a href="{{ path('app_home') }}" class="{{ route == 'app_home' ? 'active' }}">Accueil</a>
            {% if is_granted('ROLE_ADMIN') %}
                <a href="{{ path('admin_dashboard') }}" class="{{ route == 'admin_dashboard' ? 'active' }}">Admin</a>
            {% endif %}
            {% if app.user %}
                <a href="{{ path('app_logout') }}">Déconnexion</a>
            {% else %}
                <a href="{{ path('app_login') }}" class="{{ route == 'app_login' ? 'active' }}">Connexion</a>
                <a href="{{ path('app_register') }}" class="{{ route == 'app_register' ? 'active' }}">Inscription</a>
            {% endif %}
        </nav>
    </header>
    <main>
        {% block body %}{% endblock %}
    </main>
</div>
</body>
</html>
